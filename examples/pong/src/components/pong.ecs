namespace pong {
    component Paddle {
        speed: f32;
        up_key: i32;
        down_key: i32;
    }

    component Velocity {
        value: core.vec2;
    }

    component GameState {
        initialized: bool;
        left_score: i32;
        right_score: i32;
        serve_direction: f32;
    }
}
