import core;

namespace pong {
    fn clamp(value: f32, minimum: f32, maximum: f32): f32 {
        if (value < minimum) {
            return minimum;
        }

        if (value > maximum) {
            return maximum;
        }

        return value;
    }

    fn move_towards(current: f32, target: f32, step: f32): f32 {
        if (current < target - step) {
            return current + step;
        }

        if (current > target + step) {
            return current - step;
        }

        return target;
    }

    fn rect_left(transform: Transform): f32 {
        return transform.position.x - (transform.scale.x * 0.5);
    }

    fn rect_right(transform: Transform): f32 {
        return transform.position.x + (transform.scale.x * 0.5);
    }

    fn rect_top(transform: Transform): f32 {
        return transform.position.y - (transform.scale.y * 0.5);
    }

    fn rect_bottom(transform: Transform): f32 {
        return transform.position.y + (transform.scale.y * 0.5);
    }

    fn overlaps(a: Transform, b: Transform): bool {
        if (rect_right(a) < rect_left(b)) {
            return false;
        }

        if (rect_left(a) > rect_right(b)) {
            return false;
        }

        if (rect_bottom(a) < rect_top(b)) {
            return false;
        }

        if (rect_top(a) > rect_bottom(b)) {
            return false;
        }

        return true;
    }

    fn reset_ball(ball: Transform, velocity: Velocity, direction: f32) {
        ball.position.x = 960.0 * 0.5;
        ball.position.y = 540.0 * 0.5;
        ball.rotation = 0.0;
        velocity.value.x = 420.0 * direction;
        velocity.value.y = 420.0 * 0.35;
    }

    [After<core.time>]
    [Before<core.window>]
    [Before<core.renderer>]
    system Bootstrap {
        if (getFirstEntity<GameState>() != null) {
            return;
        }

        let game_state_entity: entity = spawn();
        let tick_state_entity: entity = spawn();
        let left_paddle: entity = spawn();
        let right_paddle: entity = spawn();
        let ball: entity = spawn();
        let center_line: entity = spawn();

        game_state_entity[GameState].left_paddle = left_paddle;
        game_state_entity[GameState].right_paddle = right_paddle;
        game_state_entity[GameState].ball = ball;
        game_state_entity[GameState].left_score = 0;
        game_state_entity[GameState].right_score = 0;
        game_state_entity[GameState].serve_direction = 1.0;

        tick_state_entity[TickState].should_update = false;
        tick_state_entity[TickState].accumulator_ns = 0;
        tick_state_entity[TickState].total_elapsed_ns = 0;
        tick_state_entity[TickState].update_count = 0;
        tick_state_entity[TickState].delta_seconds = 0.0;

        left_paddle[Transform].position.x = 40.0;
        left_paddle[Transform].position.y = 540.0 * 0.5;
        left_paddle[Transform].scale.x = 16.0;
        left_paddle[Transform].scale.y = 100.0;
        left_paddle[Transform].rotation = 0.0;
        left_paddle[GraphicsShape].color.x = 1.0;
        left_paddle[GraphicsShape].color.y = 1.0;
        left_paddle[GraphicsShape].color.z = 1.0;
        left_paddle[GraphicsShape].color.w = 1.0;
        left_paddle[GraphicsShape].kind = 1;

        right_paddle[Transform].position.x = 960.0 - 40.0;
        right_paddle[Transform].position.y = 540.0 * 0.5;
        right_paddle[Transform].scale.x = 16.0;
        right_paddle[Transform].scale.y = 100.0;
        right_paddle[Transform].rotation = 0.0;
        right_paddle[GraphicsShape].color.x = 1.0;
        right_paddle[GraphicsShape].color.y = 1.0;
        right_paddle[GraphicsShape].color.z = 1.0;
        right_paddle[GraphicsShape].color.w = 1.0;
        right_paddle[GraphicsShape].kind = 1;

        ball[Transform].position.x = 960.0 * 0.5;
        ball[Transform].position.y = 540.0 * 0.5;
        ball[Transform].scale.x = 16.0;
        ball[Transform].scale.y = 16.0;
        ball[Transform].rotation = 0.0;
        ball[GraphicsShape].color.x = 1.0;
        ball[GraphicsShape].color.y = 0.85;
        ball[GraphicsShape].color.z = 0.2;
        ball[GraphicsShape].color.w = 1.0;
        ball[GraphicsShape].kind = 1;
        ball[Velocity].value.x = 420.0;
        ball[Velocity].value.y = 420.0 * 0.35;

        center_line[Transform].position.x = 960.0 * 0.5;
        center_line[Transform].position.y = 540.0 * 0.5;
        center_line[Transform].scale.x = 6.0;
        center_line[Transform].scale.y = 540.0 * 0.8;
        center_line[Transform].rotation = 0.0;
        center_line[GraphicsShape].color.x = 1.0;
        center_line[GraphicsShape].color.y = 1.0;
        center_line[GraphicsShape].color.z = 1.0;
        center_line[GraphicsShape].color.w = 0.15;
        center_line[GraphicsShape].kind = 1;

        print("pong.bootstrap");
    }

    [After<core.time>]
    [After<pong.Bootstrap>]
    [Before<core.window>]
    [Before<core.renderer>]
    system UpdateTickState {
        let time_entity: entity = getFirstEntity<Time>();
        let tick_state_entity: entity = getFirstEntity<TickState>();

        if (time_entity == null || tick_state_entity == null) {
            return;
        }

        let time: Time = time_entity[Time];
        let tick: TickState = tick_state_entity[TickState];

        tick.should_update = false;
        tick.delta_seconds = 0.0;
        tick.total_elapsed_ns = tick.total_elapsed_ns + time.last_tick_duration_ns;
        tick.accumulator_ns = tick.accumulator_ns + time.last_tick_duration_ns;

        if (time.tick_count == 1.0) {
            tick.should_update = true;
            tick.delta_seconds = 1.0 / 60.0;
            tick.update_count = tick.update_count + 1.0;
        } else if (tick.accumulator_ns >= 16666667) {
            tick.accumulator_ns = tick.accumulator_ns - 16666667;
            tick.should_update = true;
            tick.delta_seconds = 1.0 / 60.0;
            tick.update_count = tick.update_count + 1.0;
        }

        if (tick.should_update && tick.update_count == 1.0) {
            print("pong.tick-state");
        }

        if (tick.total_elapsed_ns >= 5000000000) {
            print("pong.stop");
            stop();
        }
    }

    [After<pong.UpdateTickState>]
    [Before<core.window>]
    [Before<core.renderer>]
    system TrackPaddles {
        let game_state_entity: entity = getFirstEntity<GameState>();
        let tick_state_entity: entity = getFirstEntity<TickState>();

        if (game_state_entity == null || tick_state_entity == null) {
            return;
        }

        let tick: TickState = tick_state_entity[TickState];
        if (!tick.should_update) {
            return;
        }

        if (tick.update_count == 1.0) {
            print("pong.track-paddles");
        }

        let game_state: GameState = game_state_entity[GameState];
        let ball: Transform = game_state.ball[Transform];
        let left_paddle: Transform = game_state.left_paddle[Transform];
        let right_paddle: Transform = game_state.right_paddle[Transform];
        let movement_step: f32 = 320.0 * tick.delta_seconds;
        let minimum_y: f32 = 50.0;
        let maximum_y: f32 = 540.0 - 50.0;

        left_paddle.position.y = clamp(
            move_towards(left_paddle.position.y, ball.position.y, movement_step),
            minimum_y,
            maximum_y
        );
        right_paddle.position.y = clamp(
            move_towards(right_paddle.position.y, ball.position.y, movement_step),
            minimum_y,
            maximum_y
        );
    }

    [After<pong.TrackPaddles>]
    [Before<core.window>]
    [Before<core.renderer>]
    system MoveBall {
        let game_state_entity: entity = getFirstEntity<GameState>();
        let tick_state_entity: entity = getFirstEntity<TickState>();

        if (game_state_entity == null || tick_state_entity == null) {
            return;
        }

        let tick: TickState = tick_state_entity[TickState];
        if (!tick.should_update) {
            return;
        }

        if (tick.update_count == 1.0) {
            print("pong.move-ball");
        }

        let game_state: GameState = game_state_entity[GameState];
        let ball: Transform = game_state.ball[Transform];
        let velocity: Velocity = game_state.ball[Velocity];

        ball.position.x = ball.position.x + (velocity.value.x * tick.delta_seconds);
        ball.position.y = ball.position.y + (velocity.value.y * tick.delta_seconds);
        ball.rotation = ball.rotation + (2.5 * tick.delta_seconds);
    }

    [After<pong.MoveBall>]
    [Before<core.window>]
    [Before<core.renderer>]
    system BounceBall {
        let game_state_entity: entity = getFirstEntity<GameState>();
        let tick_state_entity: entity = getFirstEntity<TickState>();

        if (game_state_entity == null || tick_state_entity == null) {
            return;
        }

        let tick: TickState = tick_state_entity[TickState];
        if (!tick.should_update) {
            return;
        }

        if (tick.update_count == 1.0) {
            print("pong.bounce-ball");
        }

        let game_state: GameState = game_state_entity[GameState];
        let ball: Transform = game_state.ball[Transform];
        let velocity: Velocity = game_state.ball[Velocity];
        let left_paddle: Transform = game_state.left_paddle[Transform];
        let right_paddle: Transform = game_state.right_paddle[Transform];

        if (rect_top(ball) <= 0.0) {
            ball.position.y = ball.scale.y * 0.5;
            velocity.value.y = 0.0 - velocity.value.y;
        } else if (rect_bottom(ball) >= 540.0) {
            ball.position.y = 540.0 - (ball.scale.y * 0.5);
            velocity.value.y = 0.0 - velocity.value.y;
        }

        if (velocity.value.x < 0.0 && overlaps(ball, left_paddle)) {
            let offset: f32 = (ball.position.y - left_paddle.position.y) / 50.0;
            ball.position.x = rect_right(left_paddle) + (ball.scale.x * 0.5);
            velocity.value.x = 420.0;
            velocity.value.y = offset * 420.0 * 0.75;
        } else if (velocity.value.x > 0.0 && overlaps(ball, right_paddle)) {
            let offset: f32 = (ball.position.y - right_paddle.position.y) / 50.0;
            ball.position.x = rect_left(right_paddle) - (ball.scale.x * 0.5);
            velocity.value.x = 0.0 - 420.0;
            velocity.value.y = offset * 420.0 * 0.75;
        }
    }

    [After<pong.BounceBall>]
    [Before<core.window>]
    [Before<core.renderer>]
    system ScoreBall {
        let game_state_entity: entity = getFirstEntity<GameState>();
        let tick_state_entity: entity = getFirstEntity<TickState>();

        if (game_state_entity == null || tick_state_entity == null) {
            return;
        }

        let tick: TickState = tick_state_entity[TickState];
        if (!tick.should_update) {
            return;
        }

        if (tick.update_count == 1.0) {
            print("pong.score-ball");
        }

        let game_state: GameState = game_state_entity[GameState];
        let ball: Transform = game_state.ball[Transform];
        let velocity: Velocity = game_state.ball[Velocity];

        if (ball.position.x < 0.0) {
            game_state.right_score = game_state.right_score + 1.0;
            game_state.serve_direction = 1.0;
            reset_ball(ball, velocity, game_state.serve_direction);
            print("pong.score.right");
        } else if (ball.position.x > 960.0) {
            game_state.left_score = game_state.left_score + 1.0;
            game_state.serve_direction = -1.0;
            reset_ball(ball, velocity, game_state.serve_direction);
            print("pong.score.left");
        }
    }
}
