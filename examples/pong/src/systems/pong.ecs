import core;

namespace pong {
    const DEFAULT_WINDOW_WIDTH: f32 = 960.0;
    const DEFAULT_WINDOW_HEIGHT: f32 = 540.0;
    const PADDLE_WIDTH: f32 = 16.0;
    const PADDLE_HEIGHT: f32 = 100.0;
    const BALL_SIZE: f32 = 16.0;
    const BALL_SPEED: f32 = 420.0;
    const WALL_THICKNESS: f32 = 20.0;
    const GOAL_THICKNESS: f32 = 24.0;
    const LEFT_PADDLE_X: f32 = 40.0;
    const RIGHT_PADDLE_MARGIN: f32 = 40.0;
    const CENTER_LINE_WIDTH: f32 = 6.0;
    const SIDE_NONE: i32 = 0;
    const SIDE_LEFT: i32 = -1;
    const SIDE_RIGHT: i32 = 1;
    const KEY_DOWN: i32 = 81;
    const KEY_UP: i32 = 82;

    fn abs(value: f32): f32 {
        if (value < 0.0) {
            return 0.0 - value;
        }

        return value;
    }

    fn move_towards(current: f32, target: f32, step: f32): f32 {
        if (current < target - step) {
            return current + step;
        }

        if (current > target + step) {
            return current - step;
        }

        return target;
    }

    fn window_width_from_entity(window_entity: entity): f32 {
        if (window_entity != null) {
            let window: Window = window_entity[Window];
            return window.width;
        }

        return DEFAULT_WINDOW_WIDTH;
    }

    fn window_height_from_entity(window_entity: entity): f32 {
        if (window_entity != null) {
            let window: Window = window_entity[Window];
            return window.height;
        }

        return DEFAULT_WINDOW_HEIGHT;
    }

    fn collision_half_width(collision: Collision): f32 {
        return collision.size.x * 0.5;
    }

    fn collision_half_height(collision: Collision): f32 {
        return collision.size.y * 0.5;
    }

    fn collision_left(transform: Transform, collision: Collision): f32 {
        return transform.position.x - collision_half_width(collision);
    }

    fn collision_right(transform: Transform, collision: Collision): f32 {
        return transform.position.x + collision_half_width(collision);
    }

    fn collision_top(transform: Transform, collision: Collision): f32 {
        return transform.position.y - collision_half_height(collision);
    }

    fn collision_bottom(transform: Transform, collision: Collision): f32 {
        return transform.position.y + collision_half_height(collision);
    }

    fn overlap_x(a_transform: Transform, a_collision: Collision, b_transform: Transform, b_collision: Collision): f32 {
        return core.math.min(
            collision_right(a_transform, a_collision),
            collision_right(b_transform, b_collision)
        ) - core.math.max(
            collision_left(a_transform, a_collision),
            collision_left(b_transform, b_collision)
        );
    }

    fn overlap_y(a_transform: Transform, a_collision: Collision, b_transform: Transform, b_collision: Collision): f32 {
        return core.math.min(
            collision_bottom(a_transform, a_collision),
            collision_bottom(b_transform, b_collision)
        ) - core.math.max(
            collision_top(a_transform, a_collision),
            collision_top(b_transform, b_collision)
        );
    }

    fn overlaps(a_transform: Transform, a_collision: Collision, b_transform: Transform, b_collision: Collision): bool {
        if (overlap_x(a_transform, a_collision, b_transform, b_collision) <= 0.0) {
            return false;
        }

        if (overlap_y(a_transform, a_collision, b_transform, b_collision) <= 0.0) {
            return false;
        }

        return true;
    }

    fn clamp_paddle_y(window: Window, collision: Collision, value: f32): f32 {
        return core.math.clamp(
            value,
            collision_half_height(collision),
            window.height - collision_half_height(collision)
        );
    }

    fn paddle_rebound_y(ball: Transform, paddle: Transform, paddle_collision: Collision): f32 {
        return ((ball.position.y - paddle.position.y) / collision_half_height(paddle_collision)) *
            BALL_SPEED *
            0.75;
    }

    fn reset_ball(ball: Transform, velocity: Velocity, window: Window) {
        ball.position.x = window.width * 0.5;
        ball.position.y = window.height * 0.5;
        ball.rotation = 0.0;
        velocity.value.x = 0.0;
        velocity.value.y = 0.0;
    }

    fn start_ball(velocity: Velocity) {
        let horizontal_pick: i32 = core.math.randomInt(0, 1);
        let vertical_pick: i32 = core.math.randomInt(0, 1);

        if (horizontal_pick == 0) {
            velocity.value.x = 0.0 - BALL_SPEED;
        } else {
            velocity.value.x = BALL_SPEED;
        }

        if (vertical_pick == 0) {
            velocity.value.y = 0.0 - (BALL_SPEED * 0.35);
        } else {
            velocity.value.y = BALL_SPEED * 0.35;
        }
    }

    [After(core.Window)]
    [Before(core.Renderer)]
    system Bootstrap {
        if (getFirstEntity<GameState>() != null) {
            return;
        }

        let window_entity: entity = getFirstEntity<Window>();
        let game_state_entity: entity = spawn();
        let left_paddle: entity = spawn();
        let right_paddle: entity = spawn();
        let ball: entity = spawn();
        let center_line: entity = spawn();
        let top_wall: entity = spawn();
        let bottom_wall: entity = spawn();
        let left_goal: entity = spawn();
        let right_goal: entity = spawn();
        let right_up_monitor: entity = spawn();
        let right_down_monitor: entity = spawn();
        let right_mouse_y_monitor: entity = spawn();
        let serve_click_monitor: entity = spawn();

        game_state_entity[GameState].left_paddle = left_paddle;
        game_state_entity[GameState].right_paddle = right_paddle;
        game_state_entity[GameState].ball = ball;
        game_state_entity[GameState].right_up_monitor = right_up_monitor;
        game_state_entity[GameState].right_down_monitor = right_down_monitor;
        game_state_entity[GameState].right_mouse_y_monitor = right_mouse_y_monitor;
        game_state_entity[GameState].serve_click_monitor = serve_click_monitor;
        game_state_entity[GameState].left_score = 0;
        game_state_entity[GameState].right_score = 0;
        game_state_entity[GameState].pending_goal_side = SIDE_NONE;
        game_state_entity[GameState].round_live = false;
        game_state_entity[GameState].previous_serve_click = false;

        right_up_monitor[InputMonitor].kind = core.input.MONITOR_BUTTON;
        right_up_monitor[InputMonitor].device = core.input.DEVICE_KEYBOARD;
        right_up_monitor[InputMonitor].index = KEY_UP;
        right_up_monitor[InputMonitor].value = 0.0;

        right_down_monitor[InputMonitor].kind = core.input.MONITOR_BUTTON;
        right_down_monitor[InputMonitor].device = core.input.DEVICE_KEYBOARD;
        right_down_monitor[InputMonitor].index = KEY_DOWN;
        right_down_monitor[InputMonitor].value = 0.0;

        right_mouse_y_monitor[InputMonitor].kind = core.input.MONITOR_AXIS;
        right_mouse_y_monitor[InputMonitor].device = core.input.DEVICE_MOUSE;
        right_mouse_y_monitor[InputMonitor].index = core.input.MOUSE_AXIS_Y;
        right_mouse_y_monitor[InputMonitor].value = window_height_from_entity(window_entity) * 0.5;

        serve_click_monitor[InputMonitor].kind = core.input.MONITOR_BUTTON;
        serve_click_monitor[InputMonitor].device = core.input.DEVICE_MOUSE;
        serve_click_monitor[InputMonitor].index = core.input.MOUSE_BUTTON_LEFT;
        serve_click_monitor[InputMonitor].value = 0.0;

        left_paddle[Transform].position.x = LEFT_PADDLE_X;
        left_paddle[Transform].position.y = window_height_from_entity(window_entity) * 0.5;
        left_paddle[Transform].scale.x = PADDLE_WIDTH;
        left_paddle[Transform].scale.y = PADDLE_HEIGHT;
        left_paddle[Transform].rotation = 0.0;
        left_paddle[GraphicsShape].color.x = 1.0;
        left_paddle[GraphicsShape].color.y = 1.0;
        left_paddle[GraphicsShape].color.z = 1.0;
        left_paddle[GraphicsShape].color.w = 1.0;
        left_paddle[GraphicsShape].kind = core.graphics.SHAPE_RECTANGLE;
        left_paddle[Collision].size.x = PADDLE_WIDTH;
        left_paddle[Collision].size.y = PADDLE_HEIGHT;
        left_paddle[RigidBody].restitution = 1.0;
        left_paddle[RigidBody].immovable = true;
        left_paddle[Paddle].speed = 500.0;
        left_paddle[Bot].speed = 360.0;
        left_paddle[Bot].aim_offset = 0.0;

        right_paddle[Transform].position.x = window_width_from_entity(window_entity) - RIGHT_PADDLE_MARGIN;
        right_paddle[Transform].position.y = window_height_from_entity(window_entity) * 0.5;
        right_paddle[Transform].scale.x = PADDLE_WIDTH;
        right_paddle[Transform].scale.y = PADDLE_HEIGHT;
        right_paddle[Transform].rotation = 0.0;
        right_paddle[GraphicsShape].color.x = 1.0;
        right_paddle[GraphicsShape].color.y = 1.0;
        right_paddle[GraphicsShape].color.z = 1.0;
        right_paddle[GraphicsShape].color.w = 1.0;
        right_paddle[GraphicsShape].kind = core.graphics.SHAPE_RECTANGLE;
        right_paddle[Collision].size.x = PADDLE_WIDTH;
        right_paddle[Collision].size.y = PADDLE_HEIGHT;
        right_paddle[RigidBody].restitution = 1.0;
        right_paddle[RigidBody].immovable = true;
        right_paddle[Paddle].speed = 500.0;

        ball[Transform].position.x = window_width_from_entity(window_entity) * 0.5;
        ball[Transform].position.y = window_height_from_entity(window_entity) * 0.5;
        ball[Transform].scale.x = BALL_SIZE;
        ball[Transform].scale.y = BALL_SIZE;
        ball[Transform].rotation = 0.0;
        ball[GraphicsShape].color.x = 1.0;
        ball[GraphicsShape].color.y = 0.85;
        ball[GraphicsShape].color.z = 0.2;
        ball[GraphicsShape].color.w = 1.0;
        ball[GraphicsShape].kind = core.graphics.SHAPE_CIRCLE;
        ball[Collision].size.x = BALL_SIZE;
        ball[Collision].size.y = BALL_SIZE;
        ball[RigidBody].restitution = 1.0;
        ball[RigidBody].immovable = false;
        ball[Velocity].value.x = 0.0;
        ball[Velocity].value.y = 0.0;

        center_line[Transform].position.x = window_width_from_entity(window_entity) * 0.5;
        center_line[Transform].position.y = window_height_from_entity(window_entity) * 0.5;
        center_line[Transform].scale.x = CENTER_LINE_WIDTH;
        center_line[Transform].scale.y = window_height_from_entity(window_entity) * 0.8;
        center_line[Transform].rotation = 0.0;
        center_line[GraphicsShape].color.x = 1.0;
        center_line[GraphicsShape].color.y = 1.0;
        center_line[GraphicsShape].color.z = 1.0;
        center_line[GraphicsShape].color.w = 0.15;
        center_line[GraphicsShape].kind = core.graphics.SHAPE_RECTANGLE;

        top_wall[Transform].position.x = window_width_from_entity(window_entity) * 0.5;
        top_wall[Transform].position.y = WALL_THICKNESS * 0.5;
        top_wall[Transform].scale.x = window_width_from_entity(window_entity);
        top_wall[Transform].scale.y = WALL_THICKNESS;
        top_wall[Transform].rotation = 0.0;
        top_wall[Collision].size.x = window_width_from_entity(window_entity);
        top_wall[Collision].size.y = WALL_THICKNESS;
        top_wall[RigidBody].restitution = 1.0;
        top_wall[RigidBody].immovable = true;

        bottom_wall[Transform].position.x = window_width_from_entity(window_entity) * 0.5;
        bottom_wall[Transform].position.y = window_height_from_entity(window_entity) - (WALL_THICKNESS * 0.5);
        bottom_wall[Transform].scale.x = window_width_from_entity(window_entity);
        bottom_wall[Transform].scale.y = WALL_THICKNESS;
        bottom_wall[Transform].rotation = 0.0;
        bottom_wall[Collision].size.x = window_width_from_entity(window_entity);
        bottom_wall[Collision].size.y = WALL_THICKNESS;
        bottom_wall[RigidBody].restitution = 1.0;
        bottom_wall[RigidBody].immovable = true;

        left_goal[Transform].position.x = 0.0 - (GOAL_THICKNESS * 0.5);
        left_goal[Transform].position.y = window_height_from_entity(window_entity) * 0.5;
        left_goal[Transform].scale.x = GOAL_THICKNESS;
        left_goal[Transform].scale.y = window_height_from_entity(window_entity);
        left_goal[Transform].rotation = 0.0;
        left_goal[Collision].size.x = GOAL_THICKNESS;
        left_goal[Collision].size.y = window_height_from_entity(window_entity);
        left_goal[Goal].scorer = SIDE_RIGHT;

        right_goal[Transform].position.x = window_width_from_entity(window_entity) + (GOAL_THICKNESS * 0.5);
        right_goal[Transform].position.y = window_height_from_entity(window_entity) * 0.5;
        right_goal[Transform].scale.x = GOAL_THICKNESS;
        right_goal[Transform].scale.y = window_height_from_entity(window_entity);
        right_goal[Transform].rotation = 0.0;
        right_goal[Collision].size.x = GOAL_THICKNESS;
        right_goal[Collision].size.y = window_height_from_entity(window_entity);
        right_goal[Goal].scorer = SIDE_LEFT;
    }

    [After(core.Window)]
    [After(pong.Bootstrap)]
    [Before(pong.Physics)]
    [Before(core.Renderer)]
    system ControlBots {
        let window_entity: entity = getFirstEntity<Window>();
        let game_state_entity: entity = getFirstEntity<GameState>();

        if (window_entity == null || game_state_entity == null) {
            return;
        }

        let window: Window = window_entity[Window];
        let game_state: GameState = game_state_entity[GameState];
        let ball: Transform = game_state.ball[Transform];

        for (bot_entity in getEntities(Bot)) {
            let paddle: Transform = bot_entity[Transform];
            let collision: Collision = bot_entity[Collision];
            let bot: Bot = bot_entity[Bot];

            paddle.position.y = clamp_paddle_y(
                window,
                collision,
                move_towards(
                    paddle.position.y,
                    ball.position.y + bot.aim_offset,
                    bot.speed * window.delta_seconds
                )
            );
        }
    }

    [After(core.Window)]
    [After(pong.Bootstrap)]
    [Before(pong.Physics)]
    [Before(core.Renderer)]
    system ControlRightPaddle {
        let window_entity: entity = getFirstEntity<Window>();
        let game_state_entity: entity = getFirstEntity<GameState>();

        if (window_entity == null || game_state_entity == null) {
            return;
        }

        let window: Window = window_entity[Window];
        let game_state: GameState = game_state_entity[GameState];
        let paddle: Transform = game_state.right_paddle[Transform];
        let paddle_collision: Collision = game_state.right_paddle[Collision];
        let paddle_settings: Paddle = game_state.right_paddle[Paddle];
        let up_monitor: InputMonitor = game_state.right_up_monitor[InputMonitor];
        let down_monitor: InputMonitor = game_state.right_down_monitor[InputMonitor];
        let mouse_monitor: InputMonitor = game_state.right_mouse_y_monitor[InputMonitor];
        let keyboard_input: f32 = down_monitor.value - up_monitor.value;

        if (abs(keyboard_input) > 0.0) {
            paddle.position.y = clamp_paddle_y(
                window,
                paddle_collision,
                paddle.position.y + (keyboard_input * paddle_settings.speed * window.delta_seconds)
            );
        } else {
            paddle.position.y = clamp_paddle_y(
                window,
                paddle_collision,
                move_towards(
                    paddle.position.y,
                    clamp_paddle_y(window, paddle_collision, mouse_monitor.value),
                    paddle_settings.speed * window.delta_seconds
                )
            );
        }
    }

    [After(core.Window)]
    [After(pong.Bootstrap)]
    [Before(pong.Physics)]
    [Before(core.Renderer)]
    system StartServe {
        let window_entity: entity = getFirstEntity<Window>();
        let game_state_entity: entity = getFirstEntity<GameState>();

        if (window_entity == null || game_state_entity == null) {
            return;
        }

        let window: Window = window_entity[Window];
        let game_state: GameState = game_state_entity[GameState];
        let click_monitor: InputMonitor = game_state.serve_click_monitor[InputMonitor];
        let click_pressed: bool = click_monitor.value > 0.5;

        if (!game_state.round_live &&
            click_pressed &&
            !game_state.previous_serve_click) {
            let ball: Transform = game_state.ball[Transform];
            let velocity: Velocity = game_state.ball[Velocity];

            reset_ball(ball, velocity, window);
            start_ball(velocity);
            game_state.round_live = true;
        }

        game_state.previous_serve_click = click_pressed;
    }

    [After(pong.ControlBots)]
    [After(pong.ControlRightPaddle)]
    [After(pong.StartServe)]
    [Before(pong.HandleGoals)]
    [Before(core.Renderer)]
    system Physics {
        let window_entity: entity = getFirstEntity<Window>();
        let game_state_entity: entity = getFirstEntity<GameState>();

        if (window_entity == null || game_state_entity == null) {
            return;
        }

        let window: Window = window_entity[Window];
        let game_state: GameState = game_state_entity[GameState];
        if (!game_state.round_live) {
            return;
        }

        for (moving_entity in getEntities(Velocity)) {
            let moving_transform: Transform = moving_entity[Transform];
            let moving_velocity: Velocity = moving_entity[Velocity];
            let moving_collision: Collision = moving_entity[Collision];

            if (!(moving_velocity.value.x == 0.0 &&
                  moving_velocity.value.y == 0.0)) {
                moving_transform.position.x = moving_transform.position.x +
                    (moving_velocity.value.x * window.delta_seconds);
                moving_transform.position.y = moving_transform.position.y +
                    (moving_velocity.value.y * window.delta_seconds);
                moving_transform.rotation = moving_transform.rotation + (2.5 * window.delta_seconds);

                for (goal_entity in getEntities(Goal)) {
                    let goal_transform: Transform = goal_entity[Transform];
                    let goal_collision: Collision = goal_entity[Collision];

                    if (game_state.round_live &&
                        overlaps(
                            moving_transform,
                            moving_collision,
                            goal_transform,
                            goal_collision
                        )) {
                        let goal: Goal = goal_entity[Goal];
                        game_state.pending_goal_side = goal.scorer;
                        game_state.round_live = false;
                        moving_velocity.value.x = 0.0;
                        moving_velocity.value.y = 0.0;
                    }
                }

                if (game_state.round_live) {
                    for (solid_entity in getEntities(RigidBody)) {
                        let solid_transform: Transform = solid_entity[Transform];
                        let solid_collision: Collision = solid_entity[Collision];
                        let solid_body: RigidBody = solid_entity[RigidBody];

                        if (solid_entity != moving_entity &&
                            overlaps(
                                moving_transform,
                                moving_collision,
                                solid_transform,
                                solid_collision
                            )) {
                            if (overlap_x(
                                    moving_transform,
                                    moving_collision,
                                    solid_transform,
                                    solid_collision
                                ) < overlap_y(
                                    moving_transform,
                                    moving_collision,
                                    solid_transform,
                                    solid_collision
                                )) {
                                if (moving_transform.position.x < solid_transform.position.x) {
                                    moving_transform.position.x = moving_transform.position.x - overlap_x(
                                        moving_transform,
                                        moving_collision,
                                        solid_transform,
                                        solid_collision
                                    );
                                } else {
                                    moving_transform.position.x = moving_transform.position.x + overlap_x(
                                        moving_transform,
                                        moving_collision,
                                        solid_transform,
                                        solid_collision
                                    );
                                }

                                moving_velocity.value.x = 0.0 - (moving_velocity.value.x * solid_body.restitution);
                                if (solid_entity == game_state.left_paddle ||
                                    solid_entity == game_state.right_paddle) {
                                    moving_velocity.value.y = paddle_rebound_y(
                                        moving_transform,
                                        solid_transform,
                                        solid_collision
                                    );
                                }
                            } else {
                                if (moving_transform.position.y < solid_transform.position.y) {
                                    moving_transform.position.y = moving_transform.position.y - overlap_y(
                                        moving_transform,
                                        moving_collision,
                                        solid_transform,
                                        solid_collision
                                    );
                                } else {
                                    moving_transform.position.y = moving_transform.position.y + overlap_y(
                                        moving_transform,
                                        moving_collision,
                                        solid_transform,
                                        solid_collision
                                    );
                                }

                                moving_velocity.value.y = 0.0 - (moving_velocity.value.y * solid_body.restitution);
                            }
                        }
                    }
                }
            }
        }
    }

    [After(pong.Physics)]
    [Before(core.Renderer)]
    system HandleGoals {
        let window_entity: entity = getFirstEntity<Window>();
        let game_state_entity: entity = getFirstEntity<GameState>();

        if (window_entity == null || game_state_entity == null) {
            return;
        }

        let window: Window = window_entity[Window];
        let game_state: GameState = game_state_entity[GameState];
        if (game_state.pending_goal_side == SIDE_NONE) {
            return;
        }

        let ball: Transform = game_state.ball[Transform];
        let velocity: Velocity = game_state.ball[Velocity];

        if (game_state.pending_goal_side == SIDE_LEFT) {
            game_state.left_score = game_state.left_score + 1;
        } else if (game_state.pending_goal_side == SIDE_RIGHT) {
            game_state.right_score = game_state.right_score + 1;
        }

        reset_ball(ball, velocity, window);
        game_state.pending_goal_side = SIDE_NONE;
        game_state.round_live = false;
    }
}
