import core;

namespace pong {
    const PONG_WINDOW_WIDTH: i32 = 960;
    const PONG_WINDOW_HEIGHT: i32 = 540;
    const PADDLE_SPEED: f32 = 500.0;
    const BALL_SPEED: f32 = 420.0;
    const BALL_SPEED_Y_SCALE: f32 = 0.35;
    const BALL_BOUNCE_Y_SCALE: f32 = 0.75;
    const PADDLE_HALF_HEIGHT: f32 = 50.0;
    const PADDLE_WIDTH: f32 = 16.0;
    const PADDLE_HEIGHT: f32 = 100.0;
    const BALL_SIZE: f32 = 16.0;
    const CENTER_PILLAR_WIDTH: f32 = 6.0;
    const BORDER_WIDTH: f32 = 8.0;
    const LEFT_PADDLE_X: f32 = 40.0;
    const RIGHT_PADDLE_X: f32 = 40.0;
    const BALL_ROTATION_SPEED: f32 = 2.5;
    const KEYBOARD_KIND: i32 = 1;

    fn clamp(value: f32, minimum: f32, maximum: f32): f32 {
        if (value < minimum) {
            return minimum;
        }

        if (value > maximum) {
            return maximum;
        }

        return value;
    }

    fn rect_left(transform: Transform): f32 {
        return transform.position.x - (transform.scale.x * 0.5);
    }

    fn rect_right(transform: Transform): f32 {
        return transform.position.x + (transform.scale.x * 0.5);
    }

    fn rect_top(transform: Transform): f32 {
        return transform.position.y - (transform.scale.y * 0.5);
    }

    fn rect_bottom(transform: Transform): f32 {
        return transform.position.y + (transform.scale.y * 0.5);
    }

    fn overlaps(a: Transform, b: Transform): bool {
        if (rect_right(a) < rect_left(b)) {
            return false;
        }

        if (rect_left(a) > rect_right(b)) {
            return false;
        }

        if (rect_bottom(a) < rect_top(b)) {
            return false;
        }

        if (rect_top(a) > rect_bottom(b)) {
            return false;
        }

        return true;
    }

    fn reset_ball(window: Window, ball: Transform, velocity: Velocity, direction: f32) {
        ball.position.x = window.width * 0.5;
        ball.position.y = window.height * 0.5;
        ball.rotation = 0.0;
        velocity.value.x = BALL_SPEED * direction;
        velocity.value.y = BALL_SPEED * BALL_SPEED_Y_SCALE;
    }

    fn apply_rect(
        transform: Transform,
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        rotation: f32
    ): Transform {
        transform.position.x = x;
        transform.position.y = y;
        transform.scale.x = width;
        transform.scale.y = height;
        transform.rotation = rotation;
        return transform;
    }

    fn apply_rect_shape(
        shape: GraphicsShape,
        r: f32,
        g: f32,
        b: f32,
        a: f32
    ): GraphicsShape {
        shape.color.x = r;
        shape.color.y = g;
        shape.color.z = b;
        shape.color.w = a;
        shape.kind = 0;
        return shape;
    }

    fn apply_paddle(
        paddle: Paddle,
        speed: f32,
        up_key: i32,
        down_key: i32
    ): Paddle {
        paddle.speed = speed;
        paddle.up_key = up_key;
        paddle.down_key = down_key;
        return paddle;
    }

    fn apply_velocity(velocity: Velocity, x: f32, y: f32): Velocity {
        velocity.value.x = x;
        velocity.value.y = y;
        return velocity;
    }

    system Bootstrap {
        if (getFirstEntity<GameState>() == null) {
            let game_state: entity = spawn();
            let left_wall: entity = spawn();
            let center_line: entity = spawn();
            let left_paddle: entity = spawn();
            let right_paddle: entity = spawn();
            let ball: entity = spawn();
            let left_up_monitor: entity = spawn();
            let left_down_monitor: entity = spawn();
            let right_up_monitor: entity = spawn();
            let right_down_monitor: entity = spawn();

            game_state[GameState].initialized = true;
            game_state[GameState].left_score = 0;
            game_state[GameState].right_score = 0;
            game_state[GameState].serve_direction = 1.0;

            left_wall[Transform].position.x = 30.0;
            left_wall[Transform].position.y = PONG_WINDOW_HEIGHT * 0.5;
            left_wall[Transform].scale.x = BORDER_WIDTH;
            left_wall[Transform].scale.y = PONG_WINDOW_HEIGHT * 1.0;
            left_wall[Transform].rotation = 0.0;
            left_wall[GraphicsShape].color.x = 0.2;
            left_wall[GraphicsShape].color.y = 0.2;
            left_wall[GraphicsShape].color.z = 0.2;
            left_wall[GraphicsShape].color.w = 1.0;
            left_wall[GraphicsShape].kind = 0;

            center_line[Transform].position.x = PONG_WINDOW_WIDTH * 0.5;
            center_line[Transform].position.y = PONG_WINDOW_HEIGHT * 0.5;
            center_line[Transform].scale.x = CENTER_PILLAR_WIDTH;
            center_line[Transform].scale.y = 18.0;
            center_line[Transform].rotation = 0.0;
            center_line[GraphicsShape].color.x = 1.0;
            center_line[GraphicsShape].color.y = 1.0;
            center_line[GraphicsShape].color.z = 1.0;
            center_line[GraphicsShape].color.w = 0.65;
            center_line[GraphicsShape].kind = 0;

            left_paddle[Transform].position.x = LEFT_PADDLE_X;
            left_paddle[Transform].position.y = PONG_WINDOW_HEIGHT * 0.5;
            left_paddle[Transform].scale.x = PADDLE_WIDTH;
            left_paddle[Transform].scale.y = PADDLE_HEIGHT;
            left_paddle[Transform].rotation = 0.0;
            left_paddle[GraphicsShape].color.x = 1.0;
            left_paddle[GraphicsShape].color.y = 1.0;
            left_paddle[GraphicsShape].color.z = 1.0;
            left_paddle[GraphicsShape].color.w = 1.0;
            left_paddle[GraphicsShape].kind = 0;
            left_paddle[Paddle].speed = PADDLE_SPEED;
            left_paddle[Paddle].up_key = 0;
            left_paddle[Paddle].down_key = 1;

            right_paddle[Transform].position.x = PONG_WINDOW_WIDTH - RIGHT_PADDLE_X;
            right_paddle[Transform].position.y = PONG_WINDOW_HEIGHT * 0.5;
            right_paddle[Transform].scale.x = PADDLE_WIDTH;
            right_paddle[Transform].scale.y = PADDLE_HEIGHT;
            right_paddle[Transform].rotation = 0.0;
            right_paddle[GraphicsShape].color.x = 1.0;
            right_paddle[GraphicsShape].color.y = 1.0;
            right_paddle[GraphicsShape].color.z = 1.0;
            right_paddle[GraphicsShape].color.w = 1.0;
            right_paddle[GraphicsShape].kind = 0;
            right_paddle[Paddle].speed = PADDLE_SPEED;
            right_paddle[Paddle].up_key = 2;
            right_paddle[Paddle].down_key = 3;

            ball[Transform].position.x = PONG_WINDOW_WIDTH * 0.5;
            ball[Transform].position.y = PONG_WINDOW_HEIGHT * 0.5;
            ball[Transform].scale.x = BALL_SIZE;
            ball[Transform].scale.y = BALL_SIZE;
            ball[Transform].rotation = 0.0;
            ball[GraphicsShape].color.x = 1.0;
            ball[GraphicsShape].color.y = 0.85;
            ball[GraphicsShape].color.z = 0.2;
            ball[GraphicsShape].color.w = 1.0;
            ball[GraphicsShape].kind = 0;
            ball[Velocity].value.x = BALL_SPEED;
            ball[Velocity].value.y = BALL_SPEED * BALL_SPEED_Y_SCALE;

            left_up_monitor[input.InputMonitor].kind = KEYBOARD_KIND;
            left_up_monitor[input.InputMonitor].device = 0;
            left_up_monitor[input.InputMonitor].index = 0;
            left_up_monitor[input.InputMonitor].value = 0.0;
            left_down_monitor[input.InputMonitor].kind = KEYBOARD_KIND;
            left_down_monitor[input.InputMonitor].device = 0;
            left_down_monitor[input.InputMonitor].index = 1;
            left_down_monitor[input.InputMonitor].value = 0.0;
            right_up_monitor[input.InputMonitor].kind = KEYBOARD_KIND;
            right_up_monitor[input.InputMonitor].device = 0;
            right_up_monitor[input.InputMonitor].index = 2;
            right_up_monitor[input.InputMonitor].value = 0.0;
            right_down_monitor[input.InputMonitor].kind = KEYBOARD_KIND;
            right_down_monitor[input.InputMonitor].device = 0;
            right_down_monitor[input.InputMonitor].index = 3;
            right_down_monitor[input.InputMonitor].value = 0.0;
        }
    }

    system SyncWindow(window_entity: Entity) {
        let window: Window = window_entity[Window];
        window.width = PONG_WINDOW_WIDTH;
        window.height = PONG_WINDOW_HEIGHT;
        window.delta_seconds = 1.0 / 60.0;
        window.should_close = false;
    }

    system TrackInput(input_entity: Entity) {
        let input: input.InputMonitor = input_entity[input.InputMonitor];
        if (input.kind == KEYBOARD_KIND) {
            if (input.index == 0) {
                input.value = 0.0;
            } else if (input.index == 1) {
                input.value = 0.0;
            } else if (input.index == 2) {
                input.value = 0.0;
            } else if (input.index == 3) {
                input.value = 0.0;
            }
        }
    }

    system MovePaddles(paddle_entity: Entity) {
        let paddle: Paddle = paddle_entity[Paddle];
        let transform: Transform = paddle_entity[Transform];
        let window: Window = getFirstComponent<Window>();
        let input: input.InputMonitor = getFirstComponent<input.InputMonitor>();
        let movement: f32 = 0.0;

        if (input.kind == KEYBOARD_KIND && input.index == paddle.up_key && input.value > 0.0) {
            movement = movement - (paddle.speed * window.delta_seconds);
        }

        if (input.kind == KEYBOARD_KIND && input.index == paddle.down_key && input.value > 0.0) {
            movement = movement + (paddle.speed * window.delta_seconds);
        }

        transform.position.y = clamp(
            transform.position.y + movement,
            PADDLE_HALF_HEIGHT,
            window.height - PADDLE_HALF_HEIGHT
        );
    }

    system MoveBall(ball_entity: Entity) {
        let transform: Transform = ball_entity[Transform];
        let velocity: Velocity = ball_entity[Velocity];
        let window: Window = getFirstComponent<Window>();
        transform.position.x = transform.position.x + (velocity.value.x * window.delta_seconds);
        transform.position.y = transform.position.y + (velocity.value.y * window.delta_seconds);
        transform.rotation = transform.rotation + (window.delta_seconds * BALL_ROTATION_SPEED);

        if (rect_top(transform) <= 0.0) {
            transform.position.y = transform.scale.y * 0.5;
            velocity.value.y = 0.0 - velocity.value.y;
        } else if (rect_bottom(transform) >= window.height) {
            transform.position.y = window.height - (transform.scale.y * 0.5);
            velocity.value.y = 0.0 - velocity.value.y;
        }
    }

    system ResolvePaddleHits(ball_entity: Entity) {
        let ball: Transform = ball_entity[Transform];
        let velocity: Velocity = ball_entity[Velocity];
        let paddle: Transform = getFirstComponent<Transform>();
        if (!overlaps(ball, paddle)) {
            return;
        }

        let offset: f32 = (ball.position.y - paddle.position.y) / (paddle.scale.y * 0.5);

        if (ball.position.x < paddle.position.x) {
            ball.position.x = paddle.position.x - (paddle.scale.x * 0.5) - (ball.scale.x * 0.5);
            velocity.value.x = 0.0 - velocity.value.x;
        } else {
            ball.position.x = paddle.position.x + (paddle.scale.x * 0.5) + (ball.scale.x * 0.5);
            velocity.value.x = 0.0 - velocity.value.x;
        }

        velocity.value.y = offset * BALL_SPEED * BALL_BOUNCE_Y_SCALE;
    }

    system ResetScoring(ball_entity: Entity) {
        let ball: Transform = ball_entity[Transform];
        let velocity: Velocity = ball_entity[Velocity];
        let window: Window = getFirstComponent<Window>();
        if (ball.position.x < 0.0) {
            reset_ball(window, ball, velocity, 1.0);
        } else if (ball.position.x > window.width) {
            reset_ball(window, ball, velocity, -1.0);
        }
    }
}
