namespace core {
    /**
     * Specifies an alias for a type.
     * Internally used to map source keywords to canonical types.
     */
    attribute Alias {
        identifier: string;
    }

    /**
     * Specifies that a struct is an attribute.
     */
    attribute Attribute;

    /**
     * Specifies that a struct is a component.
     */
    attribute Component;

    /**
     * Marks the type or field as deprecated. A warning will be emitted when used.
     */
    attribute Deprecated;

    /**
     * Marks a function as a managed runtime system.
     */
    attribute System;

    /**
     * Declares that the annotated system must run before another system.
     */
    attribute Before {
        type: Type;
    }

    /**
     * Declares that the annotated system must run after another system.
     */
    attribute After {
        type: Type;
    }
}
