namespace core {
    [Alias("vec2")]
    struct Vector2 {
        x: f32;
        y: f32;
    }

    [Alias("vec4")]
    struct Vector4 {
        x: f32;
        y: f32;
        z: f32;
        w: f32;
    }

    /**
     * Defines a transformation of an entity in 2D space.
     */
    component Transform {
        position: vec2;
        scale: vec2;
        rotation: f32;
    }

    component Time {
        tick_count: u64;
        last_tick_duration_ns: u64;
    }

    component Hierarchy {
        parent: entity;
        first_child: entity;
        next_sibling: entity;
    }

    namespace graphics {
        const SHAPE_RECTANGLE: i32 = 1;
        const SHAPE_CIRCLE: i32 = 2;

        /**
         * Renders a geometric shape for an entity.
         */
        component GraphicsShape {
            color: vec4;
            kind: i32;
        }
    }

    namespace input {
        const MONITOR_BUTTON: i32 = 1;
        const MONITOR_AXIS: i32 = 2;
        const DEVICE_KEYBOARD: i32 = 1;
        const DEVICE_MOUSE: i32 = 2;
        const MOUSE_AXIS_X: i32 = 0;
        const MOUSE_AXIS_Y: i32 = 1;
        const MOUSE_BUTTON_LEFT: i32 = 1;

        component InputMonitor {
            kind: i32;
            device: i32;
            index: i32;
            value: f32;
        }
    }

    namespace ui {
        component Window {
            width: i32;
            height: i32;
            delta_seconds: f32;
            closing: bool;
        }
    }
}
